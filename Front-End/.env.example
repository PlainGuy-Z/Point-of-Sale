# ============================================================
# Front-End Environment Variables (.env)
# ============================================================
# Copy file ini ke: Front-End/.env atau Front-End/.env.local
# ============================================================

# ============================================================
# API Configuration
# ============================================================
# Base URL untuk Backend API
# - Local Development: http://localhost:3000
# - Production: https://api.point-of-sale.com
VITE_API_URL=http://159.223.81.179
VITE_API_BASE_URL=http://159.223.81.179
# ============================================================
# App Configuration
# ============================================================
# App nama dan version (optional)
VITE_APP_NAME=Point of Sale
VITE_APP_VERSION=1.0.0

# ============================================================
# Feature Flags (optional)
# ============================================================
# Enable E-Menu Public Feature
VITE_FEATURE_EMENU_PUBLIC=true

# ============================================================
# Logging (optional)
# ============================================================
# Debug mode untuk development
VITE_DEBUG=true

# ============================================================
# Notes
# ============================================================
# 1. Restart dev server setelah mengubah .env:
#    npm run dev
#
# 2. Untuk production build:
#    npm run build
#
# 3. Access env variable di code:
#    import.meta.env.VITE_API_BASE_URL
#
# 4. Jangan commit sensitive data (.env ke .gitignore)
#
# ============================================================
