NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/coffeepos
DATABASE_URL=

# Comma-separated list of allowed origins (React dev server, etc.)
CORS_ORIGINS=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-super-secret-key-min-32-chars-change-me
JWT_EXPIRES_IN=24h

# Bcrypt rounds (minimum 12 for production)
BCRYPT_ROUNDS=12
