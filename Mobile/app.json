{
  "expo": {
    "name": "SmartPOS",
    "slug": "smartpos",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "smartpos",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "androidStatusBar": {
      "translucent": true,
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.smartpos.app",
      "permissions": [
        "INTERNET",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "splash": {
      "image": "./assets/SmartPos2.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d9488"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-screen-orientation",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e01c80d7-3b94-4894-a0af-2f8c57babb1b"
      }
    }
  }
}
